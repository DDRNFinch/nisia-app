{
  "name": "Evia Portal (tester)",
  "short_name": "Evia Portal",
  "description": "Evia Portal for colleges: learners, classes, staff, registers and reports.",
  "id": "/nisia-app/nisia-ui/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F6F8F9",
  "theme_color": "#6D5BD0",
  "icons": [
